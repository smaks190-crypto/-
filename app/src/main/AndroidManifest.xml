<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <attribution android:tag="voice_input" android:label="@string/app_name" />
    <attribution android:tag="default" android:label="@string/app_name" />
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".BudgetApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">

        <property
            android:name="android.app.PROPERTY_ATTRIBUTION_TAGS"
            android:value="true" />

        <receiver
            android:name="com.example.notifications.ReminderReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="com.example.ACTION_DAILY_REMINDER" />
            </intent-filter>
        </receiver>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.App.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".widgets.GoalWidgetConfigActivity"
            android:exported="true"
            android:label="@string/widget_financial_goal_label"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- 1. Виджет «Давид сегодня» (2x2 и 4x2) -->
        <receiver
            android:name=".widgets.DavidTodayWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_david_today_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_david_today_info" />
        </receiver>

        <!-- 2. Виджет «Быстрая операция» (2x1 и 4x1) -->
        <receiver
            android:name=".widgets.QuickOperationWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_quick_operation_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quick_operation_info" />
        </receiver>

        <!-- 3. Виджет «Мой бюджет» (2x2 и 4x2) -->
        <receiver
            android:name=".widgets.MyBudgetWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_my_budget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_my_budget_info" />
        </receiver>

        <!-- 4. Виджет «Финансовая цель» (2x2 и 4x2) -->
        <receiver
            android:name=".widgets.FinancialGoalWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_financial_goal_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_financial_goal_info" />
        </receiver>

        <!-- 5. Виджет «Мини-аналитика» (4x2) -->
        <receiver
            android:name=".widgets.MiniAnalyticsWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_mini_analytics_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_mini_analytics_info" />
        </receiver>

        <!-- 6. Виджет «Жабометр» (2x2 и 4x2) -->
        <receiver
            android:name=".widgets.ZhabometerWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_zhabometer_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_zhabometer_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
